<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd unit for agent-letter-bridge.

  EVERY PATH HERE IS ABSOLUTE ON PURPOSE. launchd does not share your shell's
  PATH, so a version manager (nvm, pyenv, asdf) is invisible to it and a bare
  `python3` may resolve to a different interpreter than the one you tested
  with. That failure looks like "the bot is dead" and costs a morning.

  Run `alb --doctor --root ...` to see which interpreter is actually resolving
  and whether cmux can be found.

  Replace: /ABSOLUTE/PATH/TO with your own paths, and the interpreter with the
  output of `which python3` in a shell where the bridge works.

  Load:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/agent-letter-bridge.plist
  Unload: launchctl bootout gui/$(id -u)/agent-letter-bridge
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>agent-letter-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <!-- A DEDICATED VENV, not a pipx shim and not the git checkout. pipx's
         internal layout is not an operations contract; a venv you created
         next to your state directory is. Create it with:
           python3 -m venv ~/.alb/venv
           ~/.alb/venv/bin/pip install /path/to/checkout -->
    <string>/ABSOLUTE/PATH/TO/.alb/venv/bin/alb</string>
    <string>--config</string>
    <string>/ABSOLUTE/PATH/TO/bridge.env</string>
    <string>--root</string>
    <string>/ABSOLUTE/PATH/TO/state</string>
  </array>

  <!-- THE RING AND launchd: READ THIS BEFORE COPYING THE BLOCK BELOW.

       Found by an install on a second machine, after a wrong diagnosis
       (a poll timeout) was chased first. cmux refuses connections from
       processes that were not started inside cmux - "Access denied -
       only processes started inside cmux can connect". A LaunchAgent is
       by definition outside cmux, so `cmux tree` and the ring fail while
       mail is written normally. The bridge records no_live_surface and
       keeps delivering, which is the designed behaviour: a dead notifier
       never costs a letter. A longer timeout does not fix it and never
       did.

       THREE WAYS OUT, best first:

       1. RUN THE BRIDGE IN A cmux PANE, not under launchd. It is then
          inside cmux by construction: nothing to copy, nothing to go
          stale, and no capability leaves the session it belongs to.

       2. USE tmux (ALB_NOTIFIER=tmux). tmux has no such capability
          model, so a LaunchAgent can reach it with PATH alone.

       3. Copy the capability in, accepting what that means - below.

       ON (3), AND WHY IT IS LAST. CMUX_SOCKET_CAPABILITY is a bearer
       token roughly 90 characters long that grants the holder the right
       to TYPE INTO YOUR PANES. A plist created with the usual umask is
       world-readable, so pasting it here hands that ability to every
       local process that can read your home directory. This repo
       refuses to load a world-readable bridge.env for exactly this
       reason; the same reasoning applies to a file we cannot enforce.

       If you do it anyway:
         chmod 600 ~/Library/LaunchAgents/agent-letter-bridge.plist
       Copy both values from a shell that IS inside cmux
       (`env | grep ^CMUX_SOCKET`). They go stale when cmux restarts,
       and a stale capability fails the same silent way - check
       `alb --status` rather than assuming.

       PATH must include the cmux binary either way. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Applications/cmux.app/Contents/Resources/bin:/usr/bin:/bin</string>
    <!-- launchd does not inherit your HOME. -->
    <key>HOME</key>
    <string>/ABSOLUTE/PATH/TO/home</string>
    <!-- So the log is written as it happens rather than when a buffer
         fills, which matters when the log is what you have at 3am. -->
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- ONLY for route (3) above. Delete both lines for routes (1) and
         (2), and chmod 600 this file if you keep them. -->
    <key>CMUX_SOCKET_PATH</key>
    <string>/ABSOLUTE/PATH/TO/cmux.sock</string>
    <key>CMUX_SOCKET_CAPABILITY</key>
    <string>PASTE-FROM-A-cmux-PANE-SEE-ABOVE</string>
  </dict>

  <!-- RESTART ON CRASH ONLY.

       A platform conflict makes the bridge exit 0 so the token's holder keeps
       running. That is a deliberate yield, not a failure, and it must NOT be
       restarted into a fight over the token. The consequence is that a clean
       stop stays stopped - including one you did not intend. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/state/alb.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/state/alb.log</string>
</dict>
</plist>
